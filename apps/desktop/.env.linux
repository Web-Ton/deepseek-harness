# Linux packaging environment: unsigned builds, no signing services.
DSH_DESKTOP_APP_ID=com.huaweicloud.aishell
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://aishell.invalid
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://aishell.invalid"]}
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
